<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SlimA2A.Protos</RootNamespace>
    <AssemblyName>SlimA2A.Protos</AssemblyName>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <!-- Bundled into the Agntcy.SlimA2A package (see ..\SlimA2A\SlimA2A.csproj); not published standalone. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Agntcy.Slim.SlimRpc" Version="2.1.2" />
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SlimA2A" />
    <InternalsVisibleTo Include="SlimA2A.Tests" />
  </ItemGroup>

</Project>
